# Response-2000 itself is never committed (folder may be Response/ or response/)
/[Rr]esponse/

# r2x output
*_r2x/

# r2x define's reference checks: r2x's side, made on each run (tests/reference/define)
/tests/reference/define/*/r2x.*
/tests/reference/define/*/r2x-session.log
/tests/reference/define/*/solved/
/tests/reference/define/check-results.txt

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/

# Local settings and secrets
.env
*.local.toml

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Earlier experiments, kept locally only
/_archive/
